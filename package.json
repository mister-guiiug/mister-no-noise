{
  "name": "mister-no-noise",
  "version": "1.5.1",
  "description": "Firefox extension that removes recurring noise from your browsing history — by your rules, entirely local.",
  "private": true,
  "license": "MIT",
  "author": "GuiiuG",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "web-ext run --config web-ext-config.mjs",
    "lint": "web-ext lint --config web-ext-config.mjs",
    "lint:js": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "node --test",
    "build": "web-ext build --config web-ext-config.mjs --overwrite-dest",
    "paquet": "node scripts/paquet.mjs",
    "fiche-amo": "node scripts/fiche-amo.mjs",
    "captures": "node scripts/captures-amo.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.49.0",
    "prettier": "^3.10.1",
    "web-ext": "^10.8.0"
  }
}
