{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.5.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "110",
  "permissions": [
    "history",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/sw.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/icone.svg",
      "96": "icons/icone.svg"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "clean-now": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdCleanNow__"
    }
  },
  "icons": {
    "48": "icons/icone.svg",
    "96": "icons/icone.svg"
  }
}
